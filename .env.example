# Copy to .env and fill in. .env is ignored by git; real environment variables override it.
# Microsoft 365 / Outlook mailbox (the booth uses hello@Dronafy.com):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-mailbox-password
MAIL_FROM="Drona <you@yourdomain.com>"
# Gmail instead: SMTP_HOST=smtp.gmail.com and a 16-letter Google app password.

# Google Sheet for visitor details: Apps Script web app URL + the SECRET set in scripts/google-sheet.gs.
SHEET_WEBHOOK_URL=
SHEET_SECRET=

# Resend (used instead of SMTP when set; Render's free plan blocks SMTP). Verify dronafy.com in Resend first.
RESEND_API_KEY=
MAIL_REPLY_TO=hello@Dronafy.com
